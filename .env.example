# =============================================================================
# LOCAL / TEST — used on your own machine and by `npm test`. Copy this whole
# file to `.env` and fill in the values in this section to get started; the
# STAGING/PRODUCTION (Railway) section further down only matters once you
# deploy — see RAILWAY_DEPLOYMENT.md.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite file, zero config needed. Local dev ALWAYS uses SQLite — see
# "Local + Production Database Support" in README.md for why, and
# RAILWAY_DEPLOYMENT.md for the separate PostgreSQL setup used on Railway.
DATABASE_URL="file:./dev.db"

# --- Auth (single EA user, V1 has no signup flow) ---------------------------
# Login email for the one application user.
EA_LOGIN_EMAIL="ea@example.com"
# bcrypt hash of the login password. Generate with:
#   node scripts/hash-password.js "your-password-here"
# IMPORTANT: Next.js expands $VAR / ${VAR} in .env values, which corrupts a
# raw bcrypt hash (it's full of $2b$10$...). Escape every "$" as "\$", e.g.
#   EA_LOGIN_PASSWORD_HASH="\$2b\$10\$abc123..."
EA_LOGIN_PASSWORD_HASH=""
# Random 32+ char secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a throwaway value locally; Railway needs its OWN different value — see
# below. Never reuse a local dev secret in staging/production.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Google OAuth (Calendar, Drive, Gmail — one shared consent for the one
# EA user in V1). Leave blank to run all three integrations in mock mode. ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). See RAILWAY_DEPLOYMENT.md "Google OAuth configuration".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on the OAuth client. Locally
# this is localhost; on Railway it must be your Railway domain instead (see
# the STAGING/PRODUCTION section below) — never hardcode localhost in a
# deployed environment's value.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Gmail sending — the address the CRM sends automated emails "from" (must be
# the same Google account that completed the OAuth consent above).
GMAIL_SENDER_ADDRESS=""

# Booking link sent to new leads (used by the lead welcome automation).
BOOKING_LINK_URL="https://calendar.google.com/your-booking-link"

# Set to "true" to force ALL automations (email, Calendar, Drive) into
# mock/test mode even when Google credentials above are configured. Keep
# "true" for local development and staging smoke-tests; set to "false" only
# once you intend real emails/events/folders to be created.
AUTOMATIONS_TEST_MODE="true"

# --- Lead follow-up scheduler ------------------------------------------------
# Shared secret checked by the manual/external trigger endpoint
# (GET/POST /api/cron/lead-followups). On Railway, the Cron Job service runs
# the scheduler directly (no HTTP, no secret needed for that path) — this
# secret only guards the HTTP endpoint kept for manual/external triggering.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="dev-only-local-value"


# =============================================================================
# STAGING / PRODUCTION (Railway) — set these as Railway environment variables
# on the Railway service(s), NOT in this file and NOT in any committed file.
# See RAILWAY_DEPLOYMENT.md for the exact Railway dashboard steps. Everything
# below is documentation of what to set there — none of it belongs in .env.
# =============================================================================

# DATABASE_URL
#   Set this to Railway Postgres's own connection string using a Railway
#   variable reference, NOT a typed-in value:
#     ${{Postgres.DATABASE_URL}}
#   (Railway resolves this automatically once the Postgres and web/cron
#   services are linked in the same project — see RAILWAY_DEPLOYMENT.md.)
#
# AUTH_SECRET
#   A NEW random value, generated the same way as above — never the same
#   value used locally.
#
# EA_LOGIN_EMAIL / EA_LOGIN_PASSWORD_HASH
#   The real login you'll use in production. Generate the hash the same way
#   (node scripts/hash-password.js), with the same "\$"-escaping.
#
# CRON_SECRET
#   A NEW, unique random value — never the local dev value above, never
#   reused across environments.
#
# AUTOMATIONS_TEST_MODE
#   Keep "true" until you've verified staging end to end; only set "false"
#   once real Google credentials are connected and you intend real sends.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   From the same (or a separate production) Google Cloud OAuth client.
#
# GOOGLE_REDIRECT_URI
#   https://<your-railway-domain>/api/integrations/google/callback
#   This exact URL must also be added to the OAuth client's "Authorized
#   redirect URIs" in Google Cloud Console — see RAILWAY_DEPLOYMENT.md.
#
# GMAIL_SENDER_ADDRESS
#   Same as local — the Google account that completed OAuth consent.
#
# BOOKING_LINK_URL
#   Your real booking link for production leads.
#
# PORT
#   Do NOT set this yourself — Railway injects it automatically and
#   `next start` reads it natively.
