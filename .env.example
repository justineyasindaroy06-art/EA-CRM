# --- Database ---------------------------------------------------------------
# Local/demo default: SQLite file, zero config needed.
DATABASE_URL="file:./dev.db"
# Production: Postgres/Supabase. Change `provider` in prisma/schema.prisma to
# "postgresql" first (see README "Moving to Postgres/Supabase"), then set:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth (single EA user, V1 has no signup flow) ---------------------------
# Login email for the one application user.
EA_LOGIN_EMAIL="ea@example.com"
# bcrypt hash of the login password. Generate with:
#   node scripts/hash-password.js "your-password-here"
# IMPORTANT: Next.js expands $VAR / ${VAR} in .env values, which corrupts a
# raw bcrypt hash (it's full of $2b$10$...). Escape every "$" as "\$", e.g.
#   EA_LOGIN_PASSWORD_HASH="\$2b\$10\$abc123..."
EA_LOGIN_PASSWORD_HASH=""
# Random 32+ char secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# --- Google OAuth (Calendar, Drive, Gmail — one shared consent for the one
# EA user in V1). Leave blank to run all three integrations in mock mode. ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). See README "Google Cloud setup" for exact steps.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match a redirect URI registered on the OAuth client, and must
# be reachable from the browser (not localhost, once deployed).
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Gmail sending — the address the CRM sends automated emails "from" (must be
# the same Google account that completed the OAuth consent above).
GMAIL_SENDER_ADDRESS=""

# Booking link sent to new leads (used by the lead welcome automation).
BOOKING_LINK_URL="https://calendar.google.com/your-booking-link"

# Set to "true" to force ALL automations (email, Calendar, Drive) into
# mock/test mode even when Google credentials above are configured. Keep
# "true" for local development and staging smoke-tests; set to "false" only
# once you intend real emails/events/folders to be created.
AUTOMATIONS_TEST_MODE="true"

# --- Lead follow-up scheduler ------------------------------------------------
# Shared secret the scheduler endpoint checks on every call. Required before
# any scheduler (Vercel Cron, GitHub Actions, cron-job.org, etc.) can trigger
# GET/POST /api/cron/lead-followups — see README "Deploying the scheduler".
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# --- Deployment ---------------------------------------------------------------
# Public base URL of the deployed app. Used to validate/construct absolute
# URLs (e.g. in docs/scripts); not required for local dev.
# APP_URL="https://your-app.vercel.app"
